{
  "manifest_version": 3,
  "name": "B站学习模式",
  "description": "仅允许访问与学习相关的B站视频，帮助你保持专注。",
  "version": "2.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://search.bilibili.com/*",
    "https://live.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://api.live.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "content/utils.js",
        "content/overlay.js",
        "content/live-parser.js",
        "content/video-groups.js",
        "content/auto-not-interested.js",
        "content/page-blocker.js",
        "content/card-hider.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "B站学习模式守护",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/Ship2do/Bilibili_study_mode"
}
